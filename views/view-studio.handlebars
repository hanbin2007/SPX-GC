<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="light dark">
  <title>{{folder}} / {{filebasename}} | SPX Studio</title>
  <link rel="icon" href="/img/spx-gc.ico">
  <style>
    html, body { margin: 0; height: 100%; background: #f4fbf9; }
    @media (prefers-color-scheme: dark) { html, body { background: #0e1513; } }
  </style>
  <script defer src="/js/socket.io.js"></script>
  <script type="module" src="/studio/studio.js"></script>
</head>
<body>
  <!-- Studio UI source: studio-ui/ (React + MUI). Build with `npm run build:studio`. -->
  <div id="studio-root" data-project="{{folder}}" data-rundown="{{filebasename}}"></div>
  <noscript>SPX Studio 需要启用 JavaScript。</noscript>
</body>
</html>
